              {
                "Effect": "Allow",
                "Action": "secretsmanager:GetSecretValue",
                "Resource": "arn:aws:secretsmanager:us-east-1:111122223333:secret:example-api-token-*"
              },
              {
                "Effect": "Allow",
                "Action": "kms:Decrypt",
                "Resource": "arn:aws:kms:us-east-1:111122223333:key/5d1c3b2a-7e6f-4a8b-9c0d-1e2f3a4b5c6d"
              }
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    },
