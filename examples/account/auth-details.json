{
  "UserDetailList": [
    {
      "UserName": "dev",
      "Arn": "arn:aws:iam::111122223333:user/dev",
      "Path": "/",
      "GroupList": [
        "developers"
      ],
      "UserPolicyList": [
        {
          "PolicyName": "update-report-function",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": [
                  "lambda:UpdateFunctionCode",
                  "lambda:GetFunction"
                ],
                "Resource": "arn:aws:lambda:us-east-1:111122223333:function:nightly-report"
              }
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    }
  ],
  "GroupDetailList": [
    {
      "GroupName": "developers",
      "Arn": "arn:aws:iam::111122223333:group/developers",
      "Path": "/",
      "GroupPolicyList": [
        {
          "PolicyName": "assume-ops",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "sts:AssumeRole",
                "Resource": "arn:aws:iam::111122223333:role/ops"
              }
            ]
          }
        },
        {
          "PolicyName": "break-glass-with-mfa",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "sts:AssumeRole",
                "Resource": "arn:aws:iam::111122223333:role/break-glass",
                "Condition": {
                  "Bool": {
                    "aws:MultiFactorAuthPresent": "true"
                  }
                }
              }
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    }
  ],
  "RoleDetailList": [
    {
      "RoleName": "ops",
      "Arn": "arn:aws:iam::111122223333:role/ops",
      "Path": "/",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::111122223333:root"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "RolePolicyList": [
        {
          "PolicyName": "deploy",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": [
                  "iam:PassRole",
                  "ec2:RunInstances"
                ],
                "Resource": "*"
              }
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    },
    {
      "RoleName": "ec2-admin",
      "Arn": "arn:aws:iam::111122223333:role/ec2-admin",
      "Path": "/",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "ec2.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "RolePolicyList": [],
      "AttachedManagedPolicies": [
        {
          "PolicyName": "AdministratorAccess",
          "PolicyArn": "arn:aws:iam::aws:policy/AdministratorAccess"
        }
      ],
      "InstanceProfileList": [
        {
          "InstanceProfileName": "ec2-admin",
          "Arn": "arn:aws:iam::111122223333:instance-profile/ec2-admin",
          "Path": "/"
        }
      ]
    },
    {
      "RoleName": "report-runner",
      "Arn": "arn:aws:iam::111122223333:role/report-runner",
      "Path": "/",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "lambda.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "RolePolicyList": [
        {
          "PolicyName": "read-reports",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": [
                  "s3:GetObject",
                  "s3:PutObject"
                ],
                "Resource": "arn:aws:s3:::example-reports/*"
              }
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    },
    {
      "RoleName": "github-deploy",
      "Arn": "arn:aws:iam::111122223333:role/github-deploy",
      "Path": "/",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "arn:aws:iam::111122223333:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
              "StringEquals": {
                "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
              }
            }
          }
        ]
      },
      "RolePolicyList": [
        {
          "PolicyName": "deploy",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "sts:AssumeRole",
                "Resource": "arn:aws:iam::111122223333:role/ops"
              }
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    },
    {
      "RoleName": "break-glass",
      "Arn": "arn:aws:iam::111122223333:role/break-glass",
      "Path": "/",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::111122223333:root"
            },
            "Action": "sts:AssumeRole",
            "Condition": {
              "Bool": {
                "aws:MultiFactorAuthPresent": "true"
              }
            }
          }
        ]
      },
      "RolePolicyList": [],
      "AttachedManagedPolicies": [
        {
          "PolicyName": "AdministratorAccess",
          "PolicyArn": "arn:aws:iam::aws:policy/AdministratorAccess"
        }
      ],
      "Tags": [
        {
          "Key": "purpose",
          "Value": "emergency admin access, MFA required"
        }
      ]
    }
  ],
  "Policies": [
    {
      "PolicyName": "AdministratorAccess",
      "Arn": "arn:aws:iam::aws:policy/AdministratorAccess",
      "DefaultVersionId": "v1",
      "PolicyVersionList": [
        {
          "VersionId": "v1",
          "IsDefaultVersion": true,
          "Document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "*",
                "Resource": "*"
              }
            ]
          }
        }
      ]
    }
  ]
}
