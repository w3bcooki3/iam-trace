{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AppRoleReads",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::111122223333:role/app-lambda"},
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::example-app/*"
    },
    {
      "Sid": "TLSOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::example-app", "arn:aws:s3:::example-app/*"],
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    }
  ]
}
