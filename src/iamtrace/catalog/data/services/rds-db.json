{
 "prefix": "rds-db",
 "name": "RDS IAM Authentication",
 "actions": {
  "connect": {
   "access_level": "Permissions management",
   "flags": {
    "IsList": false,
    "IsPermissionManagement": true,
    "IsTaggingOnly": false,
    "IsWrite": true
   },
   "resource_types": [
    "db-user"
   ],
   "condition_keys": [],
   "data_plane": null
  }
 },
 "resources": {
  "db-user": [
   "arn:${Partition}:rds-db:${Region}:${Account}:dbuser:${DbiResourceId}/${DbUserName}"
  ]
 },
 "condition_keys": {
  "aws:ResourceTag/${TagKey}": [
   "String"
  ]
 }
}
